{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "designox-waxman-friseure.vercel.app" }],
      "destination": "/demos/waxman-friseure/index.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "designox-waxman-friseure.vercel.app" }],
      "destination": "/demos/waxman-friseure/$1"
    },
    { "source": "/", "destination": "/demos/cafe-goldjunge/index.html" },
    { "source": "/(.*)", "destination": "/demos/cafe-goldjunge/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(img|fonts|demos/[^/]+/img|demos/[^/]+/fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
